#!/bin/bash

# Read the focused Files window and print one JSON object:
# branches, recent commits, and whether the folder is a git work tree.
# Files keeps its process working directory on the active pane. The window
# title is only the folder name, so the title has to agree with that
# directory before git runs.
# GIT_TREE_VIEW names a local branch, or a merged branch the graph still
# names. It does not check out or write. A remote copy of a local branch,
# such as origin/main beside main, is not a separate row.

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null
export GIT_PAGER=cat
export PAGER=cat

here=$(dirname "$(readlink -f "$0")")
titles_file=$here/titles.json

fail() {
  jq -nc \
    --arg reason "$1" \
    --arg title "${2:-}" \
    --arg path "${3:-}" \
    '{ok: false, reason: $reason, title: $title, path: $path}'
  exit 0
}

clean_text() {
  # Drop control characters so a commit subject stays one JSON string.
  printf '%s' "$1" | tr '\000-\037' ' '
}

path=""
title=""
class=""
initial=""
home=""
commit_sel=""
view_sel=${GIT_TREE_VIEW-}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --path) path=${2:-}; shift 2 ;;
    --title) title=${2:-}; shift 2 ;;
    --class) class=${2:-}; shift 2 ;;
    --initial-class) initial=${2:-}; shift 2 ;;
    --home) home=${2:-}; shift 2 ;;
    --commit) commit_sel=${2:-}; shift 2 ;;
    *) fail "git-failed" ;;
  esac
done

if [[ -z $home ]]; then
  home=${HOME:-}
fi
home=$(readlink -f "$home" 2>/dev/null || true)
[[ -n $home && -d $home ]] || home=${HOME:-}

if [[ -z $path ]]; then
  window=$(timeout 2 hyprctl activewindow -j 2>/dev/null || true)
  [[ -n $window ]] || fail "no-window"
  class=$(jq -r '.class // ""' <<<"$window" 2>/dev/null || true)
  initial=$(jq -r '.initialClass // ""' <<<"$window" 2>/dev/null || true)
  title=$(jq -r '.title // ""' <<<"$window" 2>/dev/null || true)
  pid=$(jq -r '.pid // ""' <<<"$window" 2>/dev/null || true)
  [[ $pid =~ ^[0-9]+$ ]] || fail "cwd" "$title"
  path=$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)
  [[ -n $path && -d $path ]] || fail "cwd" "$title"
fi

title=$(clean_text "$title")
title=${title:0:200}
class=$(clean_text "$class")
initial=$(clean_text "$initial")
class=${class,,}
initial=${initial,,}

[[ $class == folio || $initial == folio ]] || fail "not-folio" "$title" "$path"

path=$(readlink -f "$path" 2>/dev/null || true)
[[ -n $path && -d $path && $path != *$'\n'* ]] || fail "cwd" "$title"

umask 077
scratch=$(mktemp -d)
data=$scratch/data
hooks=$scratch/hooks
mkdir -p "$data" "$hooks"
trap 'rm -rf "$scratch"' EXIT

keep() {
  printf '%s' "$2" > "$data/$1"
}

static_cfgs=(
  -c "core.hooksPath=$hooks"
  -c core.fsmonitor=false
  -c core.untrackedCache=false
  -c core.pager=cat
  -c core.attributesFile=/dev/null
  -c diff.external=
  -c submodule.recurse=false
  -c status.submoduleSummary=false
  -c fetch.recurseSubmodules=false
  -c diff.ignoreSubmodules=all
  -c log.showSignature=false
  -c alias.config=
  -c alias.log=
  -c alias.status=
  -c alias.rev-parse=
  -c alias.for-each-ref=
  -c alias.diff=
  -c alias.branch=
  -c alias.show=
  -c alias.switch=
  -c alias.checkout=
  -c alias.show-ref=
  -c alias.check-ref-format=
  -c pager.config=false
  -c pager.status=false
  -c pager.log=false
  -c pager.show=false
  -c pager.branch=false
  -c pager.diff=false
  -c pager.rev-parse=false
  -c pager.for-each-ref=false
  -c color.ui=false
  -c "safe.directory=$path"
)

base=$(basename "$path")
matched=0
if [[ $title == "$base" ]]; then
  matched=1
fi
if [[ $matched -eq 0 && $path == "$home" ]]; then
  if jq -e --arg title "$title" '.home | index($title) != null' "$titles_file" >/dev/null; then
    matched=1
  fi
fi
if [[ $matched -eq 0 && $path == / ]]; then
  if jq -e --arg title "$title" '.computer | index($title) != null' "$titles_file" >/dev/null; then
    matched=1
  fi
fi
[[ $matched -eq 1 ]] || fail "title-mismatch" "$title" "$path"

inside=$(timeout 3 git -C "$path" "${static_cfgs[@]}" rev-parse --is-inside-work-tree 2>/dev/null || true)
[[ $inside == true ]] || fail "not-repo" "$title" "$path"

dynamic_cfgs=()
seen_required=" "
while IFS= read -r key; do
  key=${key%$'\r'}
  [[ $key =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
  case "$key" in
    filter.*.clean|filter.*.smudge|filter.*.process)
      dynamic_cfgs+=(-c "$key=")
      name=${key#filter.}
      name=${name%.*}
      if [[ $seen_required != *" $name "* ]]; then
        dynamic_cfgs+=(-c "filter.${name}.required=false")
        seen_required+="$name "
      fi
      ;;
    filter.*.required)
      dynamic_cfgs+=(-c "$key=false")
      ;;
    diff.*.command|diff.*.textconv|diff.external|diff.tool|diff.guitool)
      dynamic_cfgs+=(-c "$key=")
      ;;
    alias.*)
      dynamic_cfgs+=(-c "$key=")
      ;;
    pager.*)
      dynamic_cfgs+=(-c "$key=false")
      ;;
  esac
done < <(timeout 3 git -C "$path" "${static_cfgs[@]}" config --name-only --list 2>/dev/null || true)

git_at() {
  local seconds=$1
  shift
  timeout "$seconds" git -C "$path" "${static_cfgs[@]}" "${dynamic_cfgs[@]}" "$@"
}

# One commit: message, the change against its first parent, and the patch.
# The hash has to be hex. A branch name, a path, or a rev walk is refused
# before git sees it. Repo diff drivers and attributes are not used.
show_commit() {
  [[ $commit_sel =~ ^[0-9a-fA-F]{8,64}$ ]] || fail "git-failed" "$title" "$path"
  local full
  full=$(git_at 5 rev-parse --verify --quiet "${commit_sel}^{commit}" 2>/dev/null || true)
  full=${full//$'\n'/}
  [[ $full =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "git-failed" "$title" "$path"

  local subject body author email when parents short stat patch
  subject=$(git_at 5 log -1 --format=%s "$full" 2>/dev/null || true)
  body=$(git_at 5 log -1 --format=%b "$full" 2>/dev/null | tr -d '\000' || true)
  author=$(git_at 5 log -1 --format=%an "$full" 2>/dev/null || true)
  email=$(git_at 5 log -1 --format=%ae "$full" 2>/dev/null || true)
  when=$(git_at 5 log -1 --format=%aI "$full" 2>/dev/null || true)
  parents=$(git_at 5 log -1 --format=%P "$full" 2>/dev/null || true)
  short=$(git_at 5 rev-parse --short=12 "$full" 2>/dev/null || true)
  stat=$(git_at 8 \
    show -m --first-parent --root --stat --format= --no-ext-diff --no-textconv --no-color --ignore-submodules=all \
    "$full" 2>/dev/null | tr -d '\000' || true)
  patch=$(git_at 8 \
    show -m --first-parent --root --format= --no-ext-diff --no-textconv --no-color --ignore-submodules=all -p \
    "$full" 2>/dev/null | tr -d '\000' | head -c 100001 || true)

  local truncated=false
  if ((${#patch} > 100000)); then
    truncated=true
    patch=${patch:0:100000}
  fi
  body=${body:0:20000}
  stat=${stat:0:20000}

  local merge=false
  local parent_count
  parent_count=$(wc -w <<<"${parents:-}")
  if [[ $parent_count -gt 1 ]]; then
    merge=true
  fi

  keep subject "$subject"
  keep body "$body"
  keep author "$author"
  keep email "$email"
  keep stat "$stat"
  keep patch "$patch"
  keep parents "$parents"

  jq -nc \
    --arg path "$path" \
    --arg title "$title" \
    --arg hash "$full" \
    --arg short "$short" \
    --arg date "$when" \
    --rawfile author "$data/author" \
    --rawfile email "$data/email" \
    --rawfile subject "$data/subject" \
    --rawfile body "$data/body" \
    --rawfile stat "$data/stat" \
    --rawfile diff "$data/patch" \
    --rawfile parents "$data/parents" \
    --argjson truncated "$truncated" \
    --argjson merge "$merge" \
    '{
      ok: true,
      kind: "commit",
      path: $path,
      title: $title,
      hash: $hash,
      short: ($short | gsub("[\u0000-\u001f]"; "") | .[0:16]),
      author: ($author | gsub("[\u0000-\u001f]"; " ") | .[0:200]),
      email: ($email | gsub("[\u0000-\u001f]"; " ") | .[0:200]),
      date: ($date | gsub("[\u0000-\u001f]"; "") | .[0:40]),
      subject: ($subject | gsub("[\u0000-\u001f]"; " ") | .[0:300]),
      body: ($body | gsub("\u0000"; "") | .[0:20000]),
      parents: ($parents | split(" ") | map(select(test("^[0-9a-fA-F]{8,64}$")))),
      stat: ($stat | gsub("\u0000"; "") | .[0:20000]),
      diff: ($diff | gsub("\u0000"; "")),
      truncated: $truncated,
      merge: $merge
    }'
}

if [[ -n $commit_sel ]]; then
  show_commit
  exit 0
fi

# Choosing a branch only selects the log. A bad name never reaches git.
fail_view() {
  jq -nc \
    --arg reason "$1" \
    --arg title "$title" \
    --arg path "$path" \
    '{ok: false, reason: $reason, title: $title, path: $path}'
  exit 0
}

branch=$(git_at 3 branch --show-current 2>/dev/null || true)
branch=$(clean_text "$branch")
head=$(git_at 3 rev-parse --short=12 HEAD 2>/dev/null || true)
head=$(clean_text "$head")
detached=false
[[ -n $branch ]] || detached=true

dirty=false
set +e
set +o pipefail
probe=$(git_at 3 status --porcelain -uall --ignore-submodules=all 2>/dev/null | head -c 1)
set -o pipefail
set -e
if [[ -n $probe ]]; then
  dirty=true
fi

sep=$'\x1f'
branches=$(git_at 5 for-each-ref \
  --sort=-committerdate \
  --count=80 \
  --format="%(refname:short)${sep}%(objectname:short)${sep}%(HEAD)${sep}%(upstream:short)${sep}%(upstream:track)${sep}%(subject)${sep}%(objectname)" \
  refs/heads 2>/dev/null || true)
# The same window the graph draws. A merged branch often has no ref left.
history=$(git_at 5 log \
  --all \
  --date-order \
  --max-count=100 \
  --pretty="tformat:%H${sep}%P${sep}%s${sep}%h" \
  2>/dev/null || true)
keep branches "$branches"
keep history "$history"
jq -nc \
  --rawfile history "$data/history" \
  --rawfile branches "$data/branches" '
  def clean:
    gsub("[\u0000-\u001f]"; " ") | .[0:160];
  def records:
    split("\n") | map(select(length > 0) | split("\u001f") | map(gsub("^\\s+|\\s+$"; "")));
  def merged_name($s):
    if ($s | test("^Merge pull request #[0-9]+ from [^ ]+/")) then
      $s | sub("^Merge pull request #[0-9]+ from [^ ]+/"; "")
    elif ($s | test("^Merge remote-tracking branch \u0027.+\u0027$")) then
      $s | capture("Merge remote-tracking branch \u0027(?<n>.+)\u0027").n
    elif ($s | test("^Merge branch \u0027.+\u0027$")) then
      $s | capture("Merge branch \u0027(?<n>.+)\u0027").n
    else "" end;
  ($branches | records | map(select(length >= 6) | .[0] | clean) | map(select(length > 0))) as $names
  | ($history | records | map(select(length >= 4))) as $rows
  | ($rows | map({key: .[0], value: {short: (.[3] | clean), subject: (.[2] | clean)}}) | from_entries) as $by
  | {
      rows: (
        [ $rows[]
          | . as $row
          | ($row[2] | merged_name(.)) as $raw
          | ($raw | clean) as $n
          | select(($n | length) > 0 and $n != "HEAD" and ($n | endswith("/HEAD") | not))
          | ($row[1] | split(" ") | map(select(length > 0))) as $ps
          | select(($ps | length) >= 2)
          | ($ps[1]) as $tip
          | select($tip | test("^[0-9a-fA-F]{40}$"))
          | ($by[$tip] // {}) as $tiprow
          | {
              name: $n,
              tip: $tip,
              hash: (if ($tiprow.short // "") != "" then $tiprow.short else $tip[0:12] end),
              current: false,
              upstream: "",
              ahead: 0,
              behind: 0,
              subject: ($tiprow.subject // ""),
              merged: true
            }
        ]
        | unique_by(.name)
        | map(select(.name as $n | ($names | index($n)) == null))
      )
    }
' > "$data/merged"

viewing=""
log_selector=(--all)
if [[ -n $view_sel ]]; then
  [[ $view_sel != *$'\n'* && $view_sel != *$'\t'* && $view_sel != *'..'* && $view_sel != -* ]] \
    || fail_view "view-failed"
  view_tip=""
  while IFS=$'\x1f' read -r name short_hash is_head upstream track subject full_hash; do
    [[ $name == "$view_sel" ]] || continue
    view_tip=${full_hash//[[:space:]]/}
    break
  done <<<"$branches"
  if [[ ! $view_tip =~ ^[0-9a-fA-F]{40,64}$ ]]; then
    keep view_sel "$view_sel"
    view_tip=$(jq -r --rawfile name "$data/view_sel" 'first(.rows[] | select(.name == $name) | .tip) // empty' "$data/merged")
    view_tip=${view_tip//[[:space:]]/}
  fi
  [[ $view_tip =~ ^[0-9a-fA-F]{40,64}$ ]] || fail_view "view-failed"
  viewing=$view_sel
  log_selector=("$view_tip")
fi

commits=$(git_at 5 log \
  "${log_selector[@]}" \
  --date-order \
  --max-count=100 \
  --pretty="tformat:%H${sep}%P${sep}%D${sep}%s${sep}%cI${sep}%h" \
  2>/dev/null || true)

keep branch "$branch"
keep viewing "$viewing"
keep head "$head"
keep commits "$commits"
jq -nc \
  --arg path "$path" \
  --arg title "$title" \
  --rawfile branch "$data/branch" \
  --rawfile viewing "$data/viewing" \
  --rawfile head "$data/head" \
  --argjson detached "$detached" \
  --argjson dirty "$dirty" \
  --rawfile branches "$data/branches" \
  --slurpfile merged "$data/merged" \
  --rawfile commits "$data/commits" '
  def clean:
    gsub("[\u0000-\u001f]"; " ") | .[0:160];
  def tracknum($pattern):
    (capture($pattern) // null) as $m
    | if $m == null then 0 else ($m.n | tonumber) end;
  def refs_of:
    if length == 0 then []
    else
      split(", ")
      | map(
          gsub("^HEAD -> "; "")
          | gsub("^tag: "; "")
          | gsub("^refs/heads/"; "")
          | gsub("^refs/remotes/"; "")
          | gsub("^refs/tags/"; "")
          | clean
        )
      | map(select(length > 0 and . != "HEAD"))
      | .[0:6]
    end;
  def records:
    split("\n") | map(select(length > 0) | split("\u001f") | map(gsub("^\\s+|\\s+$"; "")));
  {
    ok: true,
    path: $path,
    title: $title,
    branch: ($branch | clean),
    viewing: ($viewing | gsub("[\u0000-\u001f]"; "") | .[0:200]),
    head: ($head | clean),
    detached: $detached,
    dirty: $dirty,
    branches: (
      (
        ($branches | records)
        | map(select(length >= 6) | {
            name: (.[0] | clean),
            hash: (.[1] | clean),
            current: (.[2] == "*"),
            upstream: (.[3] | clean),
            ahead: (.[4] | tracknum("ahead (?<n>[0-9]+)")),
            behind: (.[4] | tracknum("behind (?<n>[0-9]+)")),
            subject: (.[5] | clean),
            merged: false
          })
        | map(select(.name | length > 0))
      )
      + ($merged[0].rows | map(del(.tip)))
      | sort_by(.current | not)
    ),
    commits: (
      ($commits | records)
      | map(select(length >= 6) | {
          hash: .[0],
          parents: (.[1] | split(" ") | map(select(length > 0))),
          refs: (.[2] | refs_of),
          subject: (.[3] | clean),
          date: .[4],
          short: (.[5] | clean)
        })
    )
  }
'
